# Path to the Chromium-based browser binary
# macOS (Brave):
CHROME_PATH=/Applications/Brave Browser.app/Contents/MacOS/Brave Browser
# Ubuntu (Chrome): /usr/bin/google-chrome-stable
# Ubuntu (Brave):  /usr/bin/brave-browser

# Remote debugging port (must match launch script)
CDP_PORT=9222

# Dedicated user-data-dir so we don't conflict with the user's normal browser session
USER_DATA_DIR=./chrome-profile

# Fastify port
PORT=3000

# Run the browser headless (no visible window). Required for prod / no-display
# servers. Uses Chrome's "new" headless mode — fingerprint-equivalent to headed.
HEADLESS=false

# 2captcha API key — used to solve Google's CAPTCHA challenges that may appear
# during pagination (Local Finder pages 2+). Without this, pagination stops on
# first block. Get a key at 2captcha.com.
TWOCAPTCHA_API_KEY=
